# Log sistem dan Cache bawaan CodeIgniter 3
application/logs/*
!application/logs/index.html
application/cache/*
!application/cache/index.html

# Konfigurasi Database dan Environment Sensitif
application/config/database.php
application/config/development/
application/config/production/

# Folder upload gambar/dokumen (folder tetap ada, isinya diabaikan)
picture/*
!picture/.gitkeep
!picture/index.html
assets/uploads/*
!assets/uploads/.gitkeep
!assets/uploads/index.html

# File konfigurasi server lokal & aaPanel
.user.ini
user.ini
*.log

# File backup / database dump temporer
*.bak
*.sql
*.tar.gz
*.zip
pesan_log.txt

# Folder IDE / Text Editor / OS
.vscode/
.idea/
.project
.settings/
Thumbs.db
.DS_Store

# Composer Dependencies / Vendor Library
vendor/
vendors/